# DigiSafe Extension — Environment Variables
# Copy this file to .env and fill in your Supabase project credentials.
# WXT requires the WXT_ prefix for environment variables to be exposed at build time.

WXT_SUPABASE_URL=https://your-project-id.supabase.co
WXT_SUPABASE_ANON_KEY=your-supabase-anon-key-here
